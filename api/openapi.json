{
  "openapi": "3.1.0",
  "info": {
    "title": "Granite Manager API",
    "description": "JSON API behind Granite Manager, a CRM for countertop and stone fabrication companies. Every request acts as the signed-in user and only sees data of that user's company.",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/me": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "Get the signed-in user",
        "description": "Returns the user behind the session, including their permission flags and\nthe company every other request acts in.",
        "operationId": "get_current_user",
        "responses": {
          "200": {
            "description": "The signed-in user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionUser"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Database error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          }
        ]
      }
    },
    "/v1/me/positions": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "List the signed-in user's positions",
        "description": "Returns the position ids (job roles such as sales rep) the user holds in\nthe company the request acts in.",
        "operationId": "list_current_user_positions",
        "responses": {
          "200": {
            "description": "Position ids in the current company",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PositionRow"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Database error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          }
        ]
      }
    },
    "/v1/customers": {
      "get": {
        "tags": [
          "customers"
        ],
        "summary": "List the company's customers",
        "description": "Returns every non-deleted customer of the caller's company, optionally\nfiltered by sales rep. Invalid leads are hidden unless `show_invalid=1`.\nWith `view=companies` it returns only customers that have a company name,\neach with revenue and project totals. Rows carry the primary email only;\nuse `POST /v1/customers/emails/batch` for all addresses.",
        "operationId": "list_customers",
        "parameters": [
          {
            "name": "view",
            "in": "query",
            "description": "`customers` (default) lists every customer. `companies` lists only\ncustomers with a company name and adds revenue and project totals.\nAny other value is treated as `customers`.",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Which list `GET /v1/customers` returns.",
              "enum": [
                "customers",
                "companies"
              ]
            }
          },
          {
            "name": "sales_rep",
            "in": "query",
            "description": "Only customers assigned to this sales rep (a user id, see\n`GET /v1/users/sales-reps`). Omit or leave empty for all reps.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "show_invalid",
            "in": "query",
            "description": "`1` also returns leads marked invalid. Ignored when `view=companies`,\nwhich never filters invalid leads out.",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "1"
          }
        ],
        "responses": {
          "200": {
            "description": "Customer rows, or company rows when `view=companies`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListResponse"
                }
              }
            }
          },
          "400": {
            "description": "`sales_rep` is not an integer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Caller is not an employee or admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Database error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          }
        ]
      }
    },
    "/v1/customers/emails/batch": {
      "post": {
        "tags": [
          "customers"
        ],
        "summary": "Get all emails of several customers",
        "description": "Returns every email address of the given customers, primary address\nfirst, keyed by customer id. Customers without emails, and ids belonging\nto another company, are absent from the result.",
        "operationId": "get_customer_emails",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailsBatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Map of customer id to email addresses, primary first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "propertyNames": {
                    "type": "string"
                  }
                },
                "example": {
                  "1000": [
                    "primary@example.com",
                    "other@example.com"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "More than 20000 ids, or a malformed body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Caller is not an employee or admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Database error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          }
        ]
      }
    },
    "/v1/users/sales-reps": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "List the company's sales reps",
        "description": "Returns the non-deleted users of the caller's company who hold the sales\nrep position. Use their ids for the `sales_rep` filter of `GET /v1/customers`.",
        "operationId": "list_sales_reps",
        "responses": {
          "200": {
            "description": "Sales reps of the current company",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserNameRow"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Caller is not an employee or admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Database error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          }
        ]
      }
    },
    "/v1/stones": {
      "get": {
        "tags": [
          "stones"
        ],
        "summary": "List the company's stones with slab availability",
        "description": "Returns the stones of the caller's company that are on display, sorted by\nname, each with counts of its slabs in the yard (`slabs`). Sold out stones\n(no available slab and not regular stock) are hidden unless\n`include_sold_out=true`; hidden and deleted stones are never returned.\nFilters combine with AND; list filters take the parameter repeated and\nmatch any value. Color ids come from the colors list, supplier ids from\nthe suppliers list.",
        "operationId": "list_stones",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "Only stones of these types, e.g. `granite`, `quartz`, `marble`.",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "supplier_id",
            "in": "query",
            "description": "Only stones bought from this supplier (a supplier id).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "color_id",
            "in": "query",
            "description": "Only stones tagged with at least one of these colors (color ids).",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int32"
              }
            }
          },
          {
            "name": "level",
            "in": "query",
            "description": "Only stones of these price levels (1 = cheapest ... 7).",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int32"
              }
            }
          },
          {
            "name": "finishing",
            "in": "query",
            "description": "Only stones with these surface finishes: `polished`, `leathered`, `honed`.",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "include_sold_out",
            "in": "query",
            "description": "`true` also returns sold out stones: no available slab and not regular\nstock. Default `false`.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stones sorted by name",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Stone"
                  }
                }
              }
            }
          },
          "400": {
            "description": "A filter has the wrong type, e.g. `supplier_id=abc`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Caller is not an employee or admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Database error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          }
        ]
      }
    },
    "/v1/sinks": {
      "get": {
        "tags": [
          "sinks"
        ],
        "summary": "List the company's sink models with free units",
        "description": "Returns the non-deleted sink models of the caller's company, sorted by\nname, each with the number of units free to sell (`available`). Models\nnot on display are included (`is_display`). Sold out models (no free unit\nand not regular stock) are hidden unless `include_sold_out=true`. Filters\ncombine with AND; `type` takes the parameter repeated and matches any value.",
        "operationId": "list_sinks",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "Only sink models of these types: `stainless 18 gauge`, `stainless 16 gauge`,\n`composite`, `ceramic`, `farm house`. Repeat the parameter for several.",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "supplier_id",
            "in": "query",
            "description": "Only sink models bought from this supplier (a supplier id).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "include_sold_out",
            "in": "query",
            "description": "`true` also returns sold out models: no free unit and not regular\nstock. Default `false`.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sink models sorted by name",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Sink"
                  }
                }
              }
            }
          },
          "400": {
            "description": "A filter has the wrong type, e.g. `supplier_id=abc`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Caller is not an employee or admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Database error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          }
        ]
      }
    },
    "/v1/faucets": {
      "get": {
        "tags": [
          "faucets"
        ],
        "summary": "List the company's faucet models with free units",
        "description": "Returns the non-deleted faucet models of the caller's company, sorted by\nname, each with the number of units free to sell (`available`). Models\nnot on display are included (`is_display`). Sold out models (no free unit\nand not regular stock) are hidden unless `include_sold_out=true`. Filters\ncombine with AND; `type` takes the parameter repeated and matches any value.",
        "operationId": "list_faucets",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "Only faucet models of these types: `single handle`, `double handle`.\nRepeat the parameter for several.",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "supplier_id",
            "in": "query",
            "description": "Only faucet models bought from this supplier (a supplier id).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "include_sold_out",
            "in": "query",
            "description": "`true` also returns sold out models: no free unit and not regular\nstock. Default `false`.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Faucet models sorted by name",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Faucet"
                  }
                }
              }
            }
          },
          "400": {
            "description": "A filter has the wrong type, e.g. `supplier_id=abc`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Caller is not an employee or admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Database error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CompanyRow": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CustomerRow"
          },
          {
            "type": "object",
            "required": [
              "projects_count"
            ],
            "properties": {
              "revenue_generated": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Sum of sale prices as a decimal string (e.g. `\"1500.00\"`), the way\nmysql2 returns DECIMAL; null when there are no sales."
              },
              "projects_count": {
                "type": "integer",
                "format": "int64",
                "description": "Number of sales."
              }
            }
          }
        ],
        "description": "A customer row of the `companies` view, with totals over its own sales\nand those of its child customers."
      },
      "CustomerRow": {
        "type": "object",
        "description": "One row of the customers table. Field names match the Remix\n`CustomersListCustomer` type exactly, including `customerTemperature`.",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "Customer id."
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Contact person's name."
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "description": "Primary email address; all addresses come from\n`POST /v1/customers/emails/batch`."
          },
          "phone": {
            "type": [
              "string",
              "null"
            ],
            "description": "Main phone number."
          },
          "phone_2": {
            "type": [
              "string",
              "null"
            ],
            "description": "Secondary phone number."
          },
          "address": {
            "type": [
              "string",
              "null"
            ],
            "description": "Street address."
          },
          "sales_rep": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "User id of the assigned sales rep."
          },
          "created_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the customer was created."
          },
          "assigned_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the current sales rep was assigned."
          },
          "sales_rep_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Name of the assigned sales rep; null if unassigned or the rep was deleted."
          },
          "company_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Company (tenant) the customer belongs to."
          },
          "source": {
            "type": [
              "string",
              "null"
            ],
            "description": "Lead source, e.g. a website form or referral."
          },
          "invalid_lead": {
            "type": [
              "string",
              "null"
            ],
            "description": "Reason the lead was marked invalid. Null or empty means valid."
          },
          "company_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Business name when the customer is a company (contractor, designer...)."
          },
          "customerTemperature": {
            "type": [
              "string",
              "null"
            ],
            "description": "Lead temperature: `hot`, `medium` or `cold`; null if not set."
          }
        }
      },
      "EmailsBatchRequest": {
        "type": "object",
        "description": "Body of `POST /v1/customers/emails/batch`.",
        "required": [
          "customer_ids"
        ],
        "properties": {
          "customer_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            },
            "description": "Customer ids to look up, at most 20000. Ids of other companies are ignored."
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "Body of every error response.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Short reason: `unauthorized`, `forbidden`, `database error`, or the\nbad-request message (e.g. `invalid sales_rep: abc`)."
          }
        }
      },
      "Faucet": {
        "type": "object",
        "description": "A faucet model the company sells, with how many units are free to sell.",
        "required": [
          "id",
          "name",
          "type",
          "url",
          "is_display",
          "regular_stock",
          "available"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "Faucet model id."
          },
          "name": {
            "type": "string",
            "description": "Model name, e.g. \"Pull-Down Chrome\"."
          },
          "type": {
            "type": "string",
            "description": "Faucet type, e.g. `single handle` or `double handle`."
          },
          "url": {
            "type": "string",
            "description": "Image URL; may be empty."
          },
          "supplier_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Supplier id; null if unknown."
          },
          "is_display": {
            "type": "boolean",
            "description": "Shown to customers in the showroom catalog."
          },
          "regular_stock": {
            "type": "boolean",
            "description": "Always orderable from the supplier, so never sold out even with no units."
          },
          "retail_price": {
            "type": [
              "string",
              "null"
            ],
            "description": "Retail price as a decimal string, e.g. `\"129.99\"`; null if not set."
          },
          "cost": {
            "type": [
              "string",
              "null"
            ],
            "description": "Purchase cost as a decimal string; null if not set."
          },
          "available": {
            "type": "integer",
            "format": "int64",
            "description": "Units in stock that are not installed on a sold slab."
          }
        }
      },
      "ListResponse": {
        "oneOf": [
          {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CustomerRow"
            }
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompanyRow"
            }
          }
        ],
        "description": "`GET /v1/customers` returns `CustomerRow`s, or `CompanyRow`s when `view=companies`."
      },
      "PositionRow": {
        "type": "object",
        "description": "A position the user holds in the current company.",
        "required": [
          "position_id"
        ],
        "properties": {
          "position_id": {
            "type": "integer",
            "format": "int32",
            "description": "`positions.id`, e.g. 1 = sales rep, 9 = super admin."
          }
        }
      },
      "SessionUser": {
        "type": "object",
        "description": "The signed-in user, after the super-admin rule is applied.",
        "required": [
          "id",
          "email",
          "is_employee",
          "is_admin",
          "is_superuser",
          "company_id",
          "pined_bar",
          "is_signature_available"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "User id."
          },
          "email": {
            "type": "string",
            "description": "Login email."
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Display name."
          },
          "phone_number": {
            "type": [
              "string",
              "null"
            ],
            "description": "Personal phone number."
          },
          "is_employee": {
            "type": "boolean",
            "description": "Staff member of the company (sees customers, deals, inventory)."
          },
          "is_admin": {
            "type": "boolean",
            "description": "Company admin. Always true for super admins."
          },
          "is_superuser": {
            "type": "boolean",
            "description": "Platform-wide superuser."
          },
          "company_id": {
            "type": "integer",
            "format": "int32",
            "description": "Company every request acts in. For a super admin this is the company\nselected in the session, otherwise the user's own company."
          },
          "pined_bar": {
            "type": "boolean",
            "description": "UI preference: the sidebar is pinned open."
          },
          "cloudtalk_agent_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "CloudTalk telephony agent id, when the user has a CloudTalk seat."
          },
          "cloudtalk_phone_number": {
            "type": [
              "string",
              "null"
            ],
            "description": "Outbound CloudTalk phone number."
          },
          "ringcentral_extension_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "RingCentral extension id, when the user has a RingCentral seat."
          },
          "ringcentral_phone_number": {
            "type": [
              "string",
              "null"
            ],
            "description": "Outbound RingCentral phone number."
          },
          "is_signature_available": {
            "type": "boolean",
            "description": "Feature flag: the user may use e-signatures."
          }
        }
      },
      "Sink": {
        "type": "object",
        "description": "A sink model the company sells, with how many units are free to sell.",
        "required": [
          "id",
          "name",
          "type",
          "url",
          "is_display",
          "regular_stock",
          "length",
          "width",
          "available"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "Sink model id."
          },
          "name": {
            "type": "string",
            "description": "Model name, e.g. \"Undermount 3219\"."
          },
          "type": {
            "type": "string",
            "description": "Sink type, e.g. `stainless 18 gauge` or `farm house`."
          },
          "url": {
            "type": "string",
            "description": "Image URL; may be empty."
          },
          "supplier_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Supplier id; null if unknown."
          },
          "is_display": {
            "type": "boolean",
            "description": "Shown to customers in the showroom catalog."
          },
          "regular_stock": {
            "type": "boolean",
            "description": "Always orderable from the supplier, so never sold out even with no units."
          },
          "length": {
            "type": "integer",
            "format": "int32",
            "description": "Length in inches; 0 if not set."
          },
          "width": {
            "type": "integer",
            "format": "int32",
            "description": "Width in inches; 0 if not set."
          },
          "retail_price": {
            "type": [
              "string",
              "null"
            ],
            "description": "Retail price as a decimal string, e.g. `\"199.00\"`; null if not set."
          },
          "cost": {
            "type": [
              "string",
              "null"
            ],
            "description": "Purchase cost as a decimal string; null if not set."
          },
          "available": {
            "type": "integer",
            "format": "int64",
            "description": "Units in stock that are not installed on a sold slab."
          }
        }
      },
      "SlabCounts": {
        "type": "object",
        "description": "Slab counts of a stone. Counts the stone's own slabs plus those of the\nstones it draws from (linked stones). Cut and deleted slabs are never\ncounted.",
        "required": [
          "total",
          "available",
          "whole_total",
          "whole_available"
        ],
        "properties": {
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "Slabs and remnants in the yard, sold or not."
          },
          "available": {
            "type": "integer",
            "format": "int64",
            "description": "Slabs and remnants not tied to a sale."
          },
          "whole_total": {
            "type": "integer",
            "format": "int64",
            "description": "Whole slabs (not remnants) in the yard, sold or not."
          },
          "whole_available": {
            "type": "integer",
            "format": "int64",
            "description": "Whole slabs (not remnants) not tied to a sale."
          }
        }
      },
      "Stone": {
        "type": "object",
        "description": "A stone (a color/material the company sells) with its slab inventory.",
        "required": [
          "id",
          "is_display",
          "on_sale",
          "regular_stock",
          "slabs"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "Stone id."
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Display name, e.g. \"Absolute Black\"."
          },
          "type": {
            "type": [
              "string",
              "null"
            ],
            "description": "Material type, lowercase: `granite`, `quartz`, `marble`, `quartzite`..."
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Image URL; null when the stone has no picture."
          },
          "supplier_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Supplier id; null if unknown."
          },
          "is_display": {
            "type": "boolean",
            "description": "Shown in catalogs. This route only returns displayed stones, so always true."
          },
          "on_sale": {
            "type": "boolean",
            "description": "Marked as on sale."
          },
          "regular_stock": {
            "type": "boolean",
            "description": "Always orderable from the supplier, so never sold out even without slabs."
          },
          "length": {
            "type": [
              "number",
              "null"
            ],
            "format": "float",
            "description": "Typical slab length in inches; null if not set."
          },
          "width": {
            "type": [
              "number",
              "null"
            ],
            "format": "float",
            "description": "Typical slab width in inches; null if not set."
          },
          "retail_price": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Retail price in whole dollars. 0 means the stone is sold by the slab\nat `cost_per_sqft`."
          },
          "cost_per_sqft": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Cost per square foot in whole dollars."
          },
          "level": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Price level, 1 (cheapest) to 7; null if not set."
          },
          "finishing": {
            "type": [
              "string",
              "null"
            ],
            "description": "Surface finish: `polished`, `leathered` or `honed`; null if not set."
          },
          "samples_amount": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Number of samples on hand."
          },
          "samples_importance": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "How important it is to keep samples in stock; null if not set."
          },
          "bundle_number": {
            "type": [
              "string",
              "null"
            ],
            "description": "Supplier bundle number, free text."
          },
          "bundle_location": {
            "type": [
              "string",
              "null"
            ],
            "description": "Where the bundle is stored in the yard, free text."
          },
          "delivery_date": {
            "type": [
              "string",
              "null"
            ],
            "description": "Expected delivery date, `YYYY-MM-DD`; null if not set."
          },
          "created_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the stone was added."
          },
          "slabs": {
            "$ref": "#/components/schemas/SlabCounts",
            "description": "Slabs on hand."
          }
        }
      },
      "UserNameRow": {
        "type": "object",
        "description": "A user's id and display name.",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "User id."
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Display name."
          }
        }
      }
    },
    "securitySchemes": {
      "session_cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__session",
        "description": "Signed React Router session cookie set by the Granite Manager login."
      }
    }
