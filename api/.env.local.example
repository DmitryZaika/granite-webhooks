# Copy to api/.env.local (gitignored) and adjust. Used by `make api-local`.
DATABASE_URL=mysql://root:granite@127.0.0.1:3307/granite_local
# Must equal SESSION_SECRET in the Remix app's .env, otherwise every cookie is rejected.
SESSION_SECRET=local-dev-session-secret
API_ALLOWED_ORIGINS=http://localhost:5173
RUST_LOG=info

# Local HTTP on localhost: a host-only, non-Secure session cookie. The defaults
# (.granite-manager.com, Secure) are for production; a browser drops them here.
SESSION_COOKIE_DOMAIN=none
SESSION_COOKIE_SECURE=false

# Self-serve billing (see the README "Self-serve billing env"). All off when unset.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLIC_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_BILLING_PLANS=
# STRIPE_AUTOMATIC_TAX=
# STRIPE_API_BASE=
# SIGNUP_TEST_PAYMENT_METHOD=
# SIGNUP_RATE_LIMITS=
# SELF_SERVE_SIGNUP_ENABLED=
# ONBOARDING_ADVANCE_CHARGING=
# CALENDLY_API_TOKEN=
# CALENDLY_BASE_URL=
# CALENDLY_ONBOARDING_URL=
# WEBHOOKS_URL=
# WEBHOOKS_KEY=
# BILLING_EMAIL_FROM_ADDRESS=
# BILLING_ALERT_EMAIL=
# SIGNUP_NOTIFY_USER_ID=
# SIGNUP_NOTIFY_EMAIL=
# APP_URL=
# PAYMENTS_APP_URL=
# LAMBDA_KEY=
