# Copy to api/.env.local (gitignored) and adjust. Used by `make api-local`.
DATABASE_URL=mysql://root:granite@127.0.0.1:3307/granite_local
# Must equal SESSION_SECRET in the Remix app's .env, otherwise every cookie is rejected.
SESSION_SECRET=local-dev-session-secret
API_ALLOWED_ORIGINS=http://localhost:5173
RUST_LOG=info
