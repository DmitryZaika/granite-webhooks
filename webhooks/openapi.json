              "string",
              "null"
            ]
          },
          "your_message": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "example": {
          "email": "jane@example.com",
          "form_name": "cabinet_quote",
          "name": "Jane Doe",
          "phone": "+13175551212",
          "referral_source": "website"
        }
      }
    },
    "securitySchemes": {
      "access_token": {
        "type": "http",
        "scheme": "bearer",
        "description": "An access token (`gmk_...`)."
      }
    }
  },
  "security": [
